#!/bin/bash
#
# Kubernetes Worker Node Bootstrap
# Rendered by Terraform templatefile().

set -Eeuo pipefail

# -------------------------------------------------------------------
# Logging / error handling
# -------------------------------------------------------------------

LOG_FILE="/var/log/worker-init.log"

exec > >(tee -a "$${LOG_FILE}") 2>&1

trap 'echo "[bootstrap][ERROR] Failed at line $${LINENO}: $${BASH_COMMAND}"' ERR

echo "============================================================"
echo "[bootstrap] Kubernetes worker bootstrap started"
echo "[bootstrap] Time: $(date)"
echo "============================================================"

# -------------------------------------------------------------------
# Terraform-injected variables
# -------------------------------------------------------------------

K8S_VERSION="${kubernetes_version}"
AWS_REGION="${aws_region}"
SSM_PATH="${ssm_join_command_path}"

CONTAINERD_CONFIG="/etc/containerd/config.toml"
KUBE_APT_KEYRING="/etc/apt/keyrings/kubernetes-apt-keyring.gpg"
DOCKER_APT_KEYRING="/etc/apt/keyrings/docker.gpg"

MAX_RETRIES=40
RETRY_INTERVAL=30

log() { echo "[bootstrap] $1"; }
error() { echo "[bootstrap][ERROR] $1" >&2; exit 1; }

# -------------------------------------------------------------------
# Network Readiness & APT Fixes
# -------------------------------------------------------------------

log "Force APT to use IPv4 only"
echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4

log "Waiting for NAT Gateway internet connectivity..."
for i in {1..30}; do
    # Bypasses domain DNS lookup entirely by pinging/curling direct IP
    if curl -s --connect-timeout 3 http://1.1.1.1 >/dev/null 2>&1 || \
       curl -s --connect-timeout 3 http://detectportal.firefox.com/success.txt | grep -q "success"; then
        log "NAT Gateway connectivity verified!"
        break
    fi
    if (( i == 30 )); then
        error "No outbound IPv4 connectivity through NAT Gateway after 30 attempts"
    fi
    log "Network not ready yet, retrying in 5 seconds ($i/30)..."
    sleep 5
done
log "NAT Gateway connectivity established!"

# -------------------------------------------------------------------
# Validate configuration
# -------------------------------------------------------------------

log "Validating configuration"
[[ -n "$${K8S_VERSION}" ]] || error "Kubernetes version is empty"
[[ -n "$${AWS_REGION}" ]] || error "AWS region is empty"
[[ -n "$${SSM_PATH}" ]] || error "SSM parameter path is empty"

# -------------------------------------------------------------------
# Detect primary network interface and private IP
# -------------------------------------------------------------------

log "Detecting node network configuration"
PRIMARY_INTERFACE=$(ip -4 route show default | awk 'NR==1 {print $5}')
[[ -n "$${PRIMARY_INTERFACE}" ]] || error "Unable to determine primary network interface"

NODE_IP=$(ip -4 addr show dev "$${PRIMARY_INTERFACE}" | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1)
[[ -n "$${NODE_IP}" ]] || error "Unable to determine node private IP"

log "Primary interface: $${PRIMARY_INTERFACE}"
log "Node private IP: $${NODE_IP}"

# -------------------------------------------------------------------
# Disable swap
# -------------------------------------------------------------------

log "Disabling swap"
swapoff -a
sed -i '/[[:space:]]swap[[:space:]]/ s/^[^#]/#&/' /etc/fstab

# -------------------------------------------------------------------
# Kernel modules & sysctl
# -------------------------------------------------------------------

log "Configuring Kubernetes kernel modules & sysctl"
cat > /etc/modules-load.d/k8s.conf <<'MODULES'
overlay
br_netfilter
MODULES

modprobe overlay
modprobe br_netfilter

cat > /etc/sysctl.d/99-kubernetes.conf <<'SYSCTL'
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
SYSCTL

sysctl --system

# -------------------------------------------------------------------
# Install system prerequisites (Resilient)
# -------------------------------------------------------------------

log "Installing required system packages"
export DEBIAN_FRONTEND=noninteractive

while fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock >/dev/null 2>&1; do
    log "Waiting for concurrent apt/dpkg locks to release..."
    sleep 5
done

for i in {1..5}; do
    apt-get update -y && break
    log "apt-get update failed, retrying ($i/5)..."
    sleep 5
    (( i == 5 )) && error "apt-get update failed after 5 attempts"
done

for i in {1..5}; do
    apt-get install -y \
        -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" \
        apt-transport-https \
        ca-certificates \
        curl \
        gnupg \
        software-properties-common \
        conntrack \
        socat \
        iptables \
        unzip && break
    log "apt-get install failed, retrying ($i/5)..."
    sleep 5
done

ARCH=$(uname -m)  # x86_64 or aarch64
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$${ARCH}.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws

# -------------------------------------------------------------------
# Verify AWS CLI & Identity
# -------------------------------------------------------------------

log "Verifying AWS CLI and identity"
command -v aws >/dev/null 2>&1 || error "AWS CLI is not installed"
aws sts get-caller-identity --region "$${AWS_REGION}"

# -------------------------------------------------------------------
# Install containerd
# -------------------------------------------------------------------

log "Installing containerd"
install -m 0755 -d /etc/apt/keyrings

if [[ ! -f "$${DOCKER_APT_KEYRING}" ]]; then
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o "$${DOCKER_APT_KEYRING}"
    chmod a+r "$${DOCKER_APT_KEYRING}"
fi

UBUNTU_CODENAME=$(. /etc/os-release && echo "$${UBUNTU_CODENAME:-$${VERSION_CODENAME}}")

cat > /etc/apt/sources.list.d/docker.list <<EOF
deb [arch=$(dpkg --print-architecture) signed-by=$${DOCKER_APT_KEYRING}] https://download.docker.com/linux/ubuntu $${UBUNTU_CODENAME} stable
EOF

apt-get update -y
apt-get install -y containerd.io

# -------------------------------------------------------------------
# Configure containerd
# -------------------------------------------------------------------

log "Configuring containerd"
mkdir -p /etc/containerd
containerd config default > "$${CONTAINERD_CONFIG}"

# Enable SystemdCgroup so kubelet and containerd share the same cgroup driver
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' "$${CONTAINERD_CONFIG}"

if ! grep -q 'SystemdCgroup = true' "$${CONTAINERD_CONFIG}"; then
    log "DEBUG: dumping generated containerd config for diagnosis"
    cat "$${CONTAINERD_CONFIG}"
    error "Failed to enable SystemdCgroup in containerd config"
fi

systemctl daemon-reload
systemctl enable containerd
systemctl restart containerd
systemctl is-active --quiet containerd || error "containerd is not running"

# -------------------------------------------------------------------
# Install Kubernetes packages
# -------------------------------------------------------------------

log "Installing Kubernetes $${K8S_VERSION}"
K8S_MINOR=$(echo "$${K8S_VERSION}" | cut -d. -f1,2)

install -m 0755 -d /etc/apt/keyrings

if [[ ! -f "$${KUBE_APT_KEYRING}" ]]; then
    curl -fsSL "https://pkgs.k8s.io/core:/stable:/v$${K8S_MINOR}/deb/Release.key" | gpg --dearmor -o "$${KUBE_APT_KEYRING}"
    chmod a+r "$${KUBE_APT_KEYRING}"
fi

cat > /etc/apt/sources.list.d/kubernetes.list <<EOF
deb [signed-by=$${KUBE_APT_KEYRING}] https://pkgs.k8s.io/core:/stable:/v$${K8S_MINOR}/deb/ /
EOF

apt-get update -y
apt-get install -y "kubelet=$${K8S_VERSION}-*" "kubeadm=$${K8S_VERSION}-*"
apt-mark hold kubelet kubeadm
systemctl enable kubelet

# -------------------------------------------------------------------
# Configure kubelet node IP
# -------------------------------------------------------------------

log "Configuring kubelet node IP"
mkdir -p /etc/systemd/system/kubelet.service.d
cat > /etc/systemd/system/kubelet.service.d/20-node-ip.conf <<EOF
[Service]
Environment="KUBELET_EXTRA_ARGS=--node-ip=$${NODE_IP}"
EOF

systemctl daemon-reload
systemctl restart kubelet

# -------------------------------------------------------------------
# Retrieve SSM join command and execute
# -------------------------------------------------------------------

log "Waiting for worker join command in SSM"
JOIN_CMD=""

for i in $(seq 1 "$${MAX_RETRIES}"); do
    log "Checking SSM parameter (attempt $${i}/$${MAX_RETRIES})"

    if JOIN_CMD=$(aws ssm get-parameter \
            --region "$${AWS_REGION}" \
            --name "$${SSM_PATH}" \
            --with-decryption \
            --query 'Parameter.Value' \
            --output text 2>/dev/null); then

        if [[ -n "$${JOIN_CMD}" && "$${JOIN_CMD}" == kubeadm\ join* ]]; then
            log "Valid kubeadm join command retrieved from SSM"
            break
        fi
        JOIN_CMD=""
    fi

    if (( i == MAX_RETRIES )); then
        error "No valid join command found after $${MAX_RETRIES} attempts"
    fi

    sleep "$${RETRY_INTERVAL}"
done

if [[ -f /etc/kubernetes/kubelet.conf ]]; then
    log "Node already joined to cluster, skipping kubeadm join"
else
    log "Joining Kubernetes cluster"
    read -r -a JOIN_ARGS <<< "$${JOIN_CMD}"
    "$${JOIN_ARGS[@]}"
fi

systemctl is-active --quiet kubelet || error "kubelet is not running after kubeadm join"

echo "============================================================"
echo "[bootstrap] Kubernetes worker bootstrap COMPLETE"
echo "============================================================"